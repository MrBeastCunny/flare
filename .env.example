# Flare production configuration. Copy to .env and fill in the REQUIRED values.
# Generate secrets with:  openssl rand -base64 48

# ---------------------------------------------------------------------------
# Public endpoint (REQUIRED)
# ---------------------------------------------------------------------------
# Hostname that serves the dashboard. Caddy obtains a TLS certificate for it.
FLARE_DOMAIN=dns.example.com
# Contact address for Let's Encrypt.
ACME_EMAIL=ops@example.com

# ---------------------------------------------------------------------------
# Secrets (REQUIRED)
# ---------------------------------------------------------------------------
# Encrypts PowerDNS API keys, OIDC client secrets and webhook secrets at rest.
# At least 32 characters. Changing it makes stored secrets unreadable.
FLARE_SECRET_KEY=
POSTGRES_PASSWORD=
PDNS_DB_PASSWORD=
PDNS_API_KEY=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_DB=flare
POSTGRES_USER=flare
PDNS_DB_NAME=pdns
PDNS_DB_USER=pdns
FLARE_DB_MAX_CONNS=25

# ---------------------------------------------------------------------------
# DNS server
# ---------------------------------------------------------------------------
# Address on the host that answers DNS on port 53.
DNS_BIND_ADDRESS=0.0.0.0
# Secondaries allowed to transfer zones (comma-separated CIDRs), and ones to NOTIFY.
PDNS_ALLOW_AXFR_IPS=127.0.0.1/32
PDNS_ALSO_NOTIFY=
PDNS_LOGLEVEL=4

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
FLARE_VERSION=1.0.0
FLARE_LOG_LEVEL=info
# Recursive resolver used to verify nameserver delegation and SSO domain TXT records.
FLARE_DNS_RESOLVER=8.8.8.8:53
FLARE_NS_CHECK_INTERVAL=5m
FLARE_SESSION_TTL=168h
# Bearer token required to scrape /metrics from inside the network (optional).
FLARE_METRICS_TOKEN=
# Allow webhooks to reach private networks (disabled to prevent SSRF).
FLARE_WEBHOOK_ALLOW_PRIVATE=false

# ---------------------------------------------------------------------------
# Email (optional; can also be configured in Instance settings)
# ---------------------------------------------------------------------------
FLARE_SMTP_HOST=
FLARE_SMTP_PORT=587
FLARE_SMTP_USERNAME=
FLARE_SMTP_PASSWORD=
FLARE_SMTP_FROM=
# starttls | tls | none
FLARE_SMTP_TLS=starttls

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
